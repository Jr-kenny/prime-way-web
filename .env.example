# Prime Way Web — environment variables.
# Copy to .env when deploying the server. Never commit a real key.
# The frontend reads VITE_API_BASE_URL at build time only.

# Relay API key for the Prime Way App (dashboard.relay.link → Apps →
# Prime way). Server-side only; never put it in frontend code.
RELAY_API_KEY=

# Port the server listens on.
PORT=3000

# Development only: when RELAY_API_KEY is unset and NODE_ENV is not
# "production", quotes and status forward to this upstream backend
# (which holds the same Prime Way App key). Default is the live
# Prime Way backend.
UPSTREAM_API_BASE=https://prime-way-backend.onrender.com

# Frontend build-time API base. Leave unset to use the built-in default
# (local /api proxy in dev, the live Prime Way backend otherwise).
# Set to "" to call the same origin that serves the frontend.
VITE_API_BASE_URL=
